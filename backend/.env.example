# Connection string DIRETA do Postgres (Supabase > Project Settings > Database).
# NÃO é a URL da API REST (https://xxxx.supabase.co) — é a de psycopg2/asyncpg.
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres

# Supabase > Project Settings > API > JWT Secret (usado pra validar o token
# que o front manda no header Authorization: Bearer <token>).
SUPABASE_JWT_SECRET=troque-por-o-jwt-secret-do-seu-projeto

# Opcional — só necessário se você quiser habilitar OCR via Gemini.
# Sem ela, o upload de documentos funciona mas sem extração automática.
GOOGLE_API_KEY=

# Onde os documentos enviados são salvos (dentro do container).
# Em produção (Render, etc.), prefira um volume persistente ou Storage externo.
UPLOAD_DIR=/app/uploads

# Origem(ns) do frontend em produção. "*" só serve pra dev local.
CORS_ORIGINS=*
